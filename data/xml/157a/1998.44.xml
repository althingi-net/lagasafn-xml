              <end xpath="superchapter[@nr='2']/chapter[@nr='2' and @chapter-type='kafli']/art[@nr='4']/subart[@nr='2']/paragraph[@nr='1']/numart[@nr='6']/paragraph[@nr='1']/sen[@nr='1']"/>
            </location>
            <location type="range" xpath="superchapter[@nr='2']/chapter[@nr='2' and @chapter-type='kafli']/art[@nr='4']/subart[@nr='2']/paragraph[@nr='1']/numart[@nr='7']/nr-title[1]" string-length="0"/>
          </footnote>
          <footnote href="https://www.althingi.is/altext/stjt/2019.137.html#G19" law-nr="137" law-year="2019" law-art="19" nr="2">
            <footnote-sen>L. 137/2019, 19. gr.</footnote-sen>
