            </location>
          </footnote>
        </footnotes>
      </art>
      <art nr="5">
        <nr-title>5. gr.</nr-title>
        <name>Sveitarstjórnir.</name>
        <subart nr="1">
          <paragraph nr="1">
            <sen nr="1">Sveitarstjórn ber ábyrgð á og hefur frumkvæði að því að leysa húsnæðisþörf þess fólks í sveitarfélaginu sem þarfnast aðstoðar við húsnæðisöflun.</sen>
            <sen nr="2">Í því skyni skal sveitarstjórn fylgjast með þörf á húsnæði í sveitarfélaginu.</sen>
            <sen nr="3">Jafnframt fer sveitarstjórn með stjórn og samræmingu húsnæðismála á vegum sveitarfélagsins.</sen>
          </paragraph>
        </subart>
        <footnotes>
          <footnote href="https://www.althingi.is/altext/stjt/2018.065.html" law-nr="65" law-year="2018" law-art="2" nr="1">
            <footnote-sen>L. 65/2018, 2. gr.</footnote-sen>
            <location type="range" xpath="superchapter[@nr='2']/chapter[@nr='2' and @chapter-type='kafli']/art[@nr='5']/subart[@nr='1']/paragraph[@nr='1']/sen[@nr='3']" string-length="0"/>
          </footnote>
        </footnotes>
      </art>
      <art nr="6">
        <nr-title>6. gr.</nr-title>
        <name>Framkvæmd verkefna sveitarfélaga.</name>
        <subart nr="1">
          <paragraph nr="1">
            <sen nr="1">Sveitarstjórn er heimilt að fela sérstakri húsnæðisnefnd eða annarri nefnd á vegum sveitarfélagsins stjórn og framkvæmd húsnæðismála samkvæmt lögum þessum.</sen>
          </paragraph>
        </subart>
        <footnotes>
          <footnote href="https://www.althingi.is/altext/stjt/2018.065.html" law-nr="65" law-year="2018" law-art="3" nr="1">
            <footnote-sen>L. 65/2018, 3. gr.</footnote-sen>
            <location type="range" string-length="189">
              <start xpath="superchapter[@nr='2']/chapter[@nr='2' and @chapter-type='kafli']/art[@nr='6']/name[1]"/>
              <end xpath="superchapter[@nr='2']/chapter[@nr='2' and @chapter-type='kafli']/art[@nr='6']/subart[@nr='1']/paragraph[@nr='1']/sen[@nr='1']"/>
            </location>
          </footnote>
        </footnotes>
      </art>
    </chapter>
