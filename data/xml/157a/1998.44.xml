    <chapter nr="4a" nr-type="roman" chapter-type="kafli" roman-nr="IV">
      <nr-title>IV. kafli A.</nr-title>
      <name>Stefnumótun á sviði húsnæðismála og húsnæðisáætlanir.</name>
      <footnotes>
        <footnote href="https://www.althingi.is/altext/stjt/2018.065.html" law-nr="65" law-year="2018" law-art="11" nr="1">
          <footnote-sen>L. 65/2018, 11. gr.</footnote-sen>
          <location type="range" string-length="66">
            <start xpath="superchapter[@nr='2']/chapter[@nr='4a' and @chapter-type='kafli']/nr-title[1]"/>
            <end xpath="superchapter[@nr='2']/chapter[@nr='4a' and @chapter-type='kafli']/name[1]"/>
          </location>
        </footnote>
      </footnotes>
      <art nr="14a">
        <nr-title>14. gr. a.</nr-title>
        <name>Húsnæðisþing.</name>
        <subart nr="1">
          <paragraph nr="1">
            <sen nr="1">Ráðherra skal boða til húsnæðisþings árlega.</sen>
          </paragraph>
        </subart>
        <subart nr="2">
          <paragraph nr="1">
            <sen nr="1">Á húsnæðisþingi skal fjalla um húsnæðismál og leggur ráðherra fram skýrslu um stöðu og þróun húsnæðismála við upphaf þingsins.</sen>
            <sen nr="2">Ráðherra ákveður verkefni þingsins hverju sinni.</sen>
          </paragraph>
        </subart>
        <subart nr="3">
          <paragraph nr="1">
            <sen nr="1">Húsnæðisþing er öllum opið og til þess skal m.a. boða alþingismenn, fulltrúa Húsnæðis- og mannvirkjastofnunar og fulltrúa sveitarfélaga, leigumarkaðarins og vinnumarkaðarins.</sen>
          </paragraph>
        </subart>
        <subart nr="4">
          <paragraph nr="1">
            <sen nr="1">Seta á þinginu er ólaunuð en nauðsynlegur kostnaður af þinghaldinu greiðist úr ríkissjóði samkvæmt ákvörðun ráðherra.</sen>
          </paragraph>
        </subart>
        <footnotes>
          <footnote href="https://www.althingi.is/altext/stjt/2019.137.html#G19" law-nr="137" law-year="2019" law-art="19" nr="1">
            <footnote-sen>L. 137/2019, 19. gr.</footnote-sen>
